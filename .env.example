# PostgreSQL connection string used by Prisma.
# Matches the docker-compose service (user: creon / password: creon / db: creon).
DATABASE_URL="postgresql://creon:creon@localhost:5432/creon?schema=public"

# HTTP port the NestJS app listens on.
PORT=3000

# Valkey (cache + short-lived wallet-auth challenges).
# Local dev values below match the valkey service in docker-compose.yml.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USE_TLS=false   # true for managed/prod Valkey
VALKEY_PASSWORD=       # optional; set in prod

# Wallet auth / JWT.
JWT_SECRET=dev-change-me               # use a long random secret in prod
JWT_EXPIRES_IN=7d
AUTH_CHALLENGE_TTL_SECONDS=300         # how long a signing challenge stays valid

# S3-compatible object storage (Cloudflare R2 in prod, MinIO in local dev).
# Local dev values below match the MinIO service in docker-compose.yml.
R2_ACCOUNT_ID=                                    # R2 only: derives the endpoint when R2_ENDPOINT is unset
R2_ACCESS_KEY_ID=creon                            # MinIO: MINIO_ROOT_USER     | R2: access key id
R2_SECRET_ACCESS_KEY=creon12345                   # MinIO: MINIO_ROOT_PASSWORD | R2: secret access key
R2_BUCKET=creon-assets
R2_KYC_BUCKET=creon-kyc                            # PRIVATE bucket for KTP/selfie PII (presigned access only)
R2_ENDPOINT=http://localhost:9000                 # MinIO local; leave blank for R2 (derived from account id)
R2_FORCE_PATH_STYLE=true                          # true for MinIO; false/unset for R2
R2_PUBLIC_URL=http://localhost:9000/creon-assets  # optional public base (R2: pub-*.r2.dev or a custom domain)

# Stellar / Soroban (on-chain integration). Phase-1 contracts are deployed to testnet;
# see contracts/deployments/testnet.json. The platform secret is the deploy/signing key
# (wired in Phase 2) — keep it out of source control.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_PLATFORM_SECRET=                                                            # Phase 2 signing key (the deployer/owner secret); must be funded
STELLAR_BASE_FEE=1000000                                                            # optional inclusion fee (stroops) per deploy/invoke tx; resource fees added on simulate
COMPLIANCE_REGISTRY_ADDRESS=CCTB7KFSZCWSIB3UGYTSDO5PBWMTKD5XCDIEGIEAYVPZSH5K3S5RANQ7  # live singleton (testnet)
SHARE_TOKEN_WASM_HASH=ae06cdbb78077ef8557d86778ffe5a2a2f5d08829245b61a76ad8f93944571fb # instantiated per-campaign in Phase 2
CAMPAIGN_WASM_HASH=462eb8f08bbd4f19b1c67e7b278aadf507b2a661455cb81a368a954e794a51aa    # instantiated per-campaign in Phase 2
USDC_CONTRACT_ADDRESS=CDZZZYLS6OFIPUHQC2YBH53FDMWXQU5VVCGVYMCNHBHL6LAUHMOS4TH7         # test USDC SAC (testnet)
