# PostgreSQL connection string used by Prisma.
# Matches the docker-compose service (user: creon / password: creon / db: creon).
DATABASE_URL="postgresql://creon:creon@localhost:5432/creon?schema=public"

# HTTP port the NestJS app listens on.
PORT=3000

# Valkey (cache + short-lived wallet-auth challenges).
# Local dev values below match the valkey service in docker-compose.yml.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USE_TLS=false   # true for managed/prod Valkey
VALKEY_PASSWORD=       # optional; set in prod

# Wallet auth / JWT.
JWT_SECRET=dev-change-me               # use a long random secret in prod
JWT_EXPIRES_IN=7d
AUTH_CHALLENGE_TTL_SECONDS=300         # how long a signing challenge stays valid

# Auth cookie (JWT is delivered as an httpOnly cookie, not in the response body).
AUTH_COOKIE_SAME_SITE=lax              # lax (same-site dev) | none (cross-site prod, requires Secure) | strict
AUTH_COOKIE_SECURE=auto                # auto (true when NODE_ENV=production, or forced true if SameSite=none) | true | false
AUTH_COOKIE_DOMAIN=                    # optional cookie Domain attribute; blank = host-only cookie

# CORS — required because cookies need an explicit origin (not "*") plus credentials:true.
CORS_ORIGIN=http://localhost:5173      # frontend origin(s) allowed to send credentialed requests; comma-separate for multiple

NODE_ENV=development                   # usually set by the host/platform in prod, not this file

# S3-compatible object storage (Cloudflare R2 in prod, MinIO in local dev).
# Local dev values below match the MinIO service in docker-compose.yml.
R2_ACCOUNT_ID=                                    # R2 only: derives the endpoint when R2_ENDPOINT is unset
R2_ACCESS_KEY_ID=creon                            # MinIO: MINIO_ROOT_USER     | R2: access key id
R2_SECRET_ACCESS_KEY=creon12345                   # MinIO: MINIO_ROOT_PASSWORD | R2: secret access key
R2_BUCKET=creon-assets
R2_KYC_BUCKET=creon-kyc                            # PRIVATE bucket for KTP/selfie PII (presigned access only)
R2_ENDPOINT=http://localhost:9000                 # MinIO local; leave blank for R2 (derived from account id)
R2_FORCE_PATH_STYLE=true                          # true for MinIO; false/unset for R2
R2_PUBLIC_URL=http://localhost:9000/creon-assets  # optional public base (R2: pub-*.r2.dev or a custom domain)

# Stellar / Soroban (on-chain integration). Phase-1 contracts are deployed to testnet;
# see contracts/deployments/testnet.json. The platform secret is the deploy/signing key
# (wired in Phase 2) — keep it out of source control.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_PLATFORM_SECRET=                                                            # Phase 2 signing key (the deployer/owner secret); must be funded
STELLAR_BASE_FEE=1000000                                                            # optional inclusion fee (stroops) per deploy/invoke tx; resource fees added on simulate
COMPLIANCE_REGISTRY_ADDRESS=CDDYCTY4BP7RMNDT5SQQMOHS6FZ5MKVPB4LIVON6MONBD2L6GWCJZ2YF  # live singleton (testnet)
SHARE_TOKEN_WASM_HASH=ae06cdbb78077ef8557d86778ffe5a2a2f5d08829245b61a76ad8f93944571fb # instantiated per-campaign in Phase 2
CAMPAIGN_WASM_HASH=d867b498f35a28ace0a8f7d0195b92bd25549eb473703f352a4d74840684bf7b    # instantiated per-campaign in Phase 2 (includes milestones + refund/cancel, re-uploaded 2026-07-03)
USDC_CONTRACT_ADDRESS=CA6NVKD2EVIK73B4YH6JO4XKA2GLGTN222VTOGXAZVNT5QHKLAT3O7N3         # test USDC SAC (testnet)

# Ownership indexer (Phase 5) — polls ShareToken events → rebuilds TokenHolding
INDEXER_POLL_INTERVAL_MS=30000                                                       # how often to poll RPC for share-token events
INDEXER_LOOKBACK_LEDGERS=9000                                                        # cold-start lookback when no Valkey cursor; MUST stay under the RPC's ~10000-ledger getEvents range cap (see token-holding-indexer.service.ts)

# Milestone fund release — off-chain investor voting, on-chain per-milestone release
MILESTONE_VOTING_WINDOW_SECONDS=604800                                               # voting window per milestone submission (default 7 days)
MILESTONE_QUORUM_BPS=3000                                                            # participation quorum as bps of total supply (3000 = 30%)
MILESTONE_APPROVAL_BPS=5000                                                          # approval threshold as bps of cast weight (5000 = strict majority)

# Test USDC faucet (public, no auth) — lets anyone (e.g. hackathon judges) self-issue
# test USDC into their own wallet via the platform key, which is the classic asset's issuer.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org                             # classic-ledger endpoint (trustline + payment ops; separate from the Soroban RPC above)
FAUCET_USDC_AMOUNT=1000                                                             # USDC minted per successful /faucet/usdc/claim call
FAUCET_CLAIM_COOLDOWN_SECONDS=86400                                                 # per-wallet cooldown between claims (default 24h)
