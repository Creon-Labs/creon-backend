generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------
enum Role {
  ENTREPRENEUR
  INVESTOR
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED // was APPROVED, now removed from the on-chain whitelist (expiry/sanction)
}

// On-chain ComplianceRegistry sync state for a KycProfile's wallet, separate from
// the KYC review status. Drives the idempotent, resumable whitelist orchestrator:
// NOT_SYNCED -> ADDING -> WHITELISTED ; WHITELISTED -> REMOVING -> REMOVED (FAILED on error).
enum WhitelistStatus {
  NOT_SYNCED
  ADDING
  WHITELISTED
  REMOVING
  REMOVED
  FAILED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum CampaignStatus {
  PENDING_DEPLOYMENT
  ACTIVE
  LOCKED
  GOAL_REACHED
  COMPLETED
  CANCELLED
}

// Deploy state machine for a campaign's on-chain contracts (separate from the
// funding-lifecycle CampaignStatus). Drives the idempotent, resumable orchestrator:
// PENDING -> DEPLOYING_TOKEN -> DEPLOYING_CAMPAIGN -> WIRING -> LIVE (FAILED on error).
enum CampaignDeployStatus {
  PENDING
  DEPLOYING_TOKEN
  DEPLOYING_CAMPAIGN
  WIRING
  LIVE
  FAILED
}

enum VaultStatus {
  PENDING
  FUNDING
  LOCKED
  RELEASED
  SETTLED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Distribution orchestrator state (snapshot -> Merkle tree -> set_distribution).
// Idempotent + resumable like the deploy/whitelist state machines; resume points
// are derived from persisted data (claims built? root posted?), so PENDING ->
// COMPLETED (FAILED on error) is enough.
enum DistributionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ClaimStatus {
  PENDING
  CLAIMED
  FAILED
}

// Milestone lifecycle: authored DRAFT (with the proposal) -> PENDING (campaign live) ->
// VOTING (entrepreneur submitted for release) -> APPROVED/REJECTED (tally) -> RELEASING
// -> RELEASED. FAILED on release error. Resume points derive from persisted tx hashes.
enum MilestoneStatus {
  DRAFT
  PENDING
  VOTING
  APPROVED
  RELEASING
  RELEASED
  REJECTED
  FAILED
}

enum VoteChoice {
  APPROVE
  REJECT
}

// ---------- models ----------
model User {
  id            String   @id @default(uuid()) @db.Uuid
  walletAddress String   @unique @map("wallet_address") @db.VarChar(56)
  email         String?  @unique
  displayName   String?  @map("display_name")
  roles         Role[]   @default([INVESTOR])
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  proposals           Proposal[]           @relation("EntrepreneurProposals")
  reviews             ProposalReview[]     @relation("AdminReviews")
  investments         Investment[]
  holdings            TokenHolding[]
  distributionClaims  DistributionClaim[]
  milestoneVotes      MilestoneVote[]
  kycProfile          KycProfile?          @relation("UserKycProfile")
  kycReviews          KycProfile[]         @relation("AdminKycReviews")

  @@map("users")
}

model KycProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  fullName        String    @map("full_name")
  nationalId      String    @unique @map("national_id") @db.VarChar(16) // NIK; unique = cegah KYC ganda
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  idCardImageKey  String    @map("id_card_image_key") // object key di bucket PRIVAT
  selfieImageKey  String?   @map("selfie_image_key")
  status          KycStatus @default(PENDING)
  submittedAt     DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text

  // On-chain whitelist sync (ComplianceRegistry add/remove). tx_hash unique = idempotent reconcile.
  whitelistStatus       WhitelistStatus @default(NOT_SYNCED) @map("whitelist_status")
  whitelistTxHash       String?         @unique @map("whitelist_tx_hash") @db.VarChar(64)
  whitelistRemoveTxHash String?         @unique @map("whitelist_remove_tx_hash") @db.VarChar(64)
  whitelistError        String?         @map("whitelist_error") @db.Text
  whitelistAttempts     Int             @default(0) @map("whitelist_attempts")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User  @relation("UserKycProfile", fields: [userId], references: [id])
  reviewedBy User? @relation("AdminKycReviews", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([whitelistStatus])
  @@map("kyc_profiles")
}

model Proposal {
  id                  String         @id @default(uuid()) @db.Uuid
  entrepreneurId      String         @map("entrepreneur_id") @db.Uuid
  businessName        String         @map("business_name")
  businessDescription String         @map("business_description") @db.Text
  category            String
  location            String?
  requestedAmount     Decimal        @map("requested_amount") @db.Decimal(28, 7)
  lockPeriodDays      Int            @map("lock_period_days")
  status              ProposalStatus @default(DRAFT)
  submittedAt         DateTime?      @map("submitted_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  entrepreneur User             @relation("EntrepreneurProposals", fields: [entrepreneurId], references: [id])
  reviews      ProposalReview[]
  campaign     Campaign?
  milestones   Milestone[]

  @@index([status])
  @@index([entrepreneurId])
  @@map("proposals")
}

model ProposalReview {
  id         String         @id @default(uuid()) @db.Uuid
  proposalId String         @map("proposal_id") @db.Uuid
  adminId    String         @map("admin_id") @db.Uuid
  decision   ReviewDecision
  notes      String?        @db.Text
  reviewedAt DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz

  proposal Proposal @relation(fields: [proposalId], references: [id])
  admin    User     @relation("AdminReviews", fields: [adminId], references: [id])

  @@index([proposalId])
  @@map("proposal_reviews")
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  proposalId      String         @unique @map("proposal_id") @db.Uuid
  contractAddress String?        @map("contract_address") @db.VarChar(56)
  goalAmount      Decimal        @map("goal_amount") @db.Decimal(28, 7)
  raisedAmount    Decimal        @default(0) @map("raised_amount") @db.Decimal(28, 7)
  status          CampaignStatus @default(PENDING_DEPLOYMENT)
  lockStartAt     DateTime?      @map("lock_start_at") @db.Timestamptz
  lockEndAt       DateTime?      @map("lock_end_at") @db.Timestamptz
  startAt         DateTime?      @map("start_at") @db.Timestamptz
  endAt           DateTime?      @map("end_at") @db.Timestamptz
  deployStatus    CampaignDeployStatus @default(PENDING) @map("deploy_status")
  deployTxHash    String?        @unique @map("deploy_tx_hash") @db.VarChar(64)
  wireTxHash      String?        @unique @map("wire_tx_hash") @db.VarChar(64)
  deployError     String?        @map("deploy_error") @db.Text
  deployAttempts  Int            @default(0) @map("deploy_attempts")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  proposal      Proposal             @relation(fields: [proposalId], references: [id])
  projectToken  ProjectToken?
  vault         CampaignVault?
  investments   Investment[]
  holdings      TokenHolding[]
  distributions ProfitDistribution[]
  milestones    Milestone[]

  @@index([status])
  @@map("campaigns")
}

model ProjectToken {
  id              String   @id @default(uuid()) @db.Uuid
  campaignId      String   @unique @map("campaign_id") @db.Uuid
  assetCode       String   @map("asset_code") @db.VarChar(12)
  issuerAddress   String?  @map("issuer_address") @db.VarChar(56)
  contractAddress String?  @map("contract_address") @db.VarChar(56)
  deployTxHash    String?  @unique @map("deploy_tx_hash") @db.VarChar(64)
  totalSupply     Decimal? @map("total_supply") @db.Decimal(28, 7)
  isTransferable  Boolean  @default(false) @map("is_transferable")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("project_tokens")
}

model CampaignVault {
  id                 String      @id @default(uuid()) @db.Uuid
  campaignId         String      @unique @map("campaign_id") @db.Uuid
  contractAddress    String?     @map("contract_address") @db.VarChar(56)
  totalDeposited     Decimal     @default(0) @map("total_deposited") @db.Decimal(28, 7)
  releasedToBusiness Decimal     @default(0) @map("released_to_business") @db.Decimal(28, 7)
  lockStartAt        DateTime?   @map("lock_start_at") @db.Timestamptz
  lockEndAt          DateTime?   @map("lock_end_at") @db.Timestamptz
  status             VaultStatus @default(PENDING)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("campaign_vaults")
}

model Investment {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  investorId String           @map("investor_id") @db.Uuid
  amount     Decimal          @db.Decimal(28, 7)
  lpTokens   Decimal?         @map("lp_tokens") @db.Decimal(28, 7)
  txHash     String?          @unique @map("tx_hash") @db.VarChar(64)
  status     InvestmentStatus @default(PENDING)
  investedAt DateTime?        @map("invested_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id])
  investor User     @relation(fields: [investorId], references: [id])

  @@index([campaignId, status])
  @@index([investorId])
  @@map("investments")
}

// Current share-token ownership, fed off-chain by the future SEP-41 event indexer.
model TokenHolding {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  holderId      String?  @map("holder_id") @db.Uuid // null if holder is an unregistered address
  holderAddress String   @map("holder_address") @db.VarChar(56)
  balance       Decimal  @default(0) @db.Decimal(28, 7)
  updatedLedger BigInt   @map("updated_ledger")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id])
  holder   User?    @relation(fields: [holderId], references: [id])

  @@unique([campaignId, holderAddress])
  @@index([holderId])
  @@map("token_holdings")
}

model ProfitDistribution {
  id             String             @id @default(uuid()) @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  onchainId      Int                @map("onchain_id") // contract distribution id (u32), per-campaign 0,1,2,…
  totalAmount    Decimal            @map("total_amount") @db.Decimal(28, 7)
  totalShares    Decimal?           @map("total_shares") @db.Decimal(28, 7) // null until the orchestrator snapshots holdings
  rewardPerShare Decimal?           @map("reward_per_share") @db.Decimal(38, 18) // null until snapshotted
  totalClaimed   Decimal            @default(0) @map("total_claimed") @db.Decimal(28, 7)
  merkleRoot     String?            @map("merkle_root") @db.VarChar(66)
  snapshotLedger BigInt?            @map("snapshot_ledger")
  depositTxHash  String?            @unique @map("deposit_tx_hash") @db.VarChar(64)
  // On-chain set_distribution(id, root) tx; unique = idempotent root post.
  setDistributionTxHash String?     @unique @map("set_distribution_tx_hash") @db.VarChar(64)
  status               DistributionStatus @default(PENDING)
  distributionError    String?      @map("distribution_error") @db.Text
  distributionAttempts Int          @default(0) @map("distribution_attempts")
  distributedAt  DateTime           @default(now()) @map("distributed_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign            @relation(fields: [campaignId], references: [id])
  claims   DistributionClaim[]

  @@unique([campaignId, onchainId])
  @@index([campaignId])
  @@map("profit_distributions")
}

model DistributionClaim {
  id             String      @id @default(uuid()) @db.Uuid
  distributionId String      @map("distribution_id") @db.Uuid
  investorId     String      @map("investor_id") @db.Uuid
  shareAmount    Decimal     @map("share_amount") @db.Decimal(28, 7)
  amount         Decimal     @db.Decimal(28, 7)
  merkleProof    String[]    @map("merkle_proof")
  leafIndex      Int?        @map("leaf_index")
  claimTxHash    String?     @unique @map("claim_tx_hash") @db.VarChar(64)
  status         ClaimStatus @default(PENDING)
  claimedAt      DateTime?   @map("claimed_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  distribution ProfitDistribution @relation(fields: [distributionId], references: [id])
  investor     User               @relation(fields: [investorId], references: [id])

  @@unique([distributionId, investorId])
  @@index([investorId])
  @@map("distribution_claims")
}

model Milestone {
  id           String          @id @default(uuid()) @db.Uuid
  proposalId   String          @map("proposal_id") @db.Uuid
  campaignId   String?         @map("campaign_id") @db.Uuid // set at proposal approval
  order        Int // 1-based display order (author-defined)
  onchainIndex Int             @map("onchain_index") // = order - 1; the contract's release_milestone(index)
  title        String
  description  String          @db.Text
  amount       Decimal         @db.Decimal(28, 7) // absolute; sum per campaign == goal
  status       MilestoneStatus @default(DRAFT)
  proofKey     String?         @map("proof_key") // object key of the proof-of-progress upload (private bucket)

  // Off-chain voting window — the ONLY time fields here. Everything else is
  // event-triggered (entrepreneur submits when ready; no schedule).
  votingStartedAt     DateTime? @map("voting_started_at") @db.Timestamptz
  votingEndsAt        DateTime? @map("voting_ends_at") @db.Timestamptz
  votingExtended      Boolean   @default(false) @map("voting_extended") // extended once if quorum missed
  snapshotTotalSupply Decimal?  @map("snapshot_total_supply") @db.Decimal(28, 7) // quorum denominator, frozen at voting open

  // On-chain release orchestrator (mirrors campaign deploy). tx_hash unique = idempotent.
  releaseTxHash   String? @unique @map("release_tx_hash") @db.VarChar(64)
  releaseError    String? @map("release_error") @db.Text
  releaseAttempts Int     @default(0) @map("release_attempts")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  proposal Proposal        @relation(fields: [proposalId], references: [id])
  campaign Campaign?       @relation(fields: [campaignId], references: [id])
  votes    MilestoneVote[]

  @@unique([proposalId, order])
  @@index([campaignId, status])
  @@map("milestones")
}

model MilestoneVote {
  id          String     @id @default(uuid()) @db.Uuid
  milestoneId String     @map("milestone_id") @db.Uuid
  investorId  String     @map("investor_id") @db.Uuid
  weight      Decimal    @db.Decimal(28, 7) // snapshotted TokenHolding.balance (= shares) at vote time
  choice      VoteChoice
  votedAt     DateTime   @default(now()) @map("voted_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  milestone Milestone @relation(fields: [milestoneId], references: [id])
  investor  User      @relation(fields: [investorId], references: [id])

  @@unique([milestoneId, investorId])
  @@index([investorId])
  @@map("milestone_votes")
}
